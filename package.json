{
  "name": "alpha-agent-mcp",
  "version": "1.0.0",
  "description": "Lightweight MCP server exposing the full @polymarket/client SDK to any stdio-capable agent host.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "alpha-agent-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5StaronSolana/Alpha-Agent-MCP.git"
  },
  "homepage": "https://github.com/5StaronSolana/Alpha-Agent-MCP#readme",
  "bugs": {
    "url": "https://github.com/5StaronSolana/Alpha-Agent-MCP/issues"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "pretest": "npm run build",
    "test": "node test/smoke-test.mjs"
  },
  "keywords": ["polymarket", "mcp", "clob", "prediction-markets", "trading"],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@polymarket/client": "^0.2.0",
    "viem": "^2.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "typescript": "^5.6.0"
  }
}
